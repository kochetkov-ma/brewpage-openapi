{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kochetkov-ma/brewpage-mcp",
  "title": "BrewPage MCP",
  "description": "Publish HTML, Markdown, KV, JSON, and files to brewpage.app from AI assistants. No signup.",
  "repository": {
    "url": "https://github.com/kochetkov-ma/brewpage-openapi",
    "source": "github",
    "subfolder": "mcp-server"
  },
  "websiteUrl": "https://brewpage.app",
  "version": "1.6.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "brewpage-mcp",
      "version": "1.6.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BREWPAGE_URL",
          "description": "Override API base URL. Defaults to https://brewpage.app.",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://brewpage.app"
        }
      ]
    }
  ]
}
