{
  "name": "brewpage-mcp",
  "version": "1.9.2",
  "mcpName": "io.github.kochetkov-ma/brewpage-mcp",
  "description": "MCP server for BrewPage — publish and manage HTML, KV, JSON, and file content from AI assistants",
  "type": "module",
  "bin": {
    "brewpage-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --import tsx --test test/smoke.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "brewpage",
    "claude",
    "claude-desktop",
    "claude-code",
    "ai",
    "hosting",
    "html",
    "markdown",
    "api"
  ],
  "author": {
    "name": "Maksim Kochetkov",
    "url": "https://github.com/kochetkov-ma"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kochetkov-ma/brewpage-openapi.git",
    "directory": "mcp-server"
  },
  "homepage": "https://brewpage.app",
  "bugs": {
    "url": "https://github.com/kochetkov-ma/brewpage-openapi/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.22.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0"
  }
}
