{
  "name": "brewpage-mcp",
  "version": "1.15.0",
  "mcpName": "io.github.kochetkov-ma/brewpage-mcp",
  "description": "MCP server for BrewPage — publish and manage HTML, sites, KV, JSON and files from AI assistants",
  "type": "module",
  "bin": {
    "brewpage-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --import tsx --test test/smoke.test.ts test/http.test.ts test/protocol.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "brewpage",
    "claude",
    "claude-desktop",
    "claude-code",
    "ai",
    "hosting",
    "html",
    "markdown",
    "api"
  ],
  "author": {
    "name": "Maksim Kochetkov",
    "url": "https://github.com/kochetkov-ma"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kochetkov-ma/brewpage-openapi.git",
    "directory": "mcp-server"
  },
  "homepage": "https://brewpage.app",
  "bugs": {
    "url": "https://github.com/kochetkov-ma/brewpage-openapi/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.15",
    "tsx": "4.22.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15",
    "hono": "4.13.14"
  }
}
