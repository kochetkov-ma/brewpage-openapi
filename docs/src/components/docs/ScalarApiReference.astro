---
---

<div id="api-doc-container" class="not-prose mt-8">
  <div id="api-doc-loading" class="flex items-center justify-center py-20 text-base-content/50">
    <span class="loading loading-spinner loading-lg text-primary mr-3"></span>
    Loading API Reference...
  </div>
  <div id="api-doc-target"></div>
</div>

<style>
  #api-doc-target :global(redoc) {
    --redoc-color-primary: #EBBB40;
  }
</style>

<script>
  const container = document.getElementById('api-doc-target');
  const loading = document.getElementById('api-doc-loading');
  if (container && !container.dataset.initialized) {
    container.dataset.initialized = 'true';

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/redoc@2.5.2/bundles/redoc.standalone.js';
    script.onload = () => {
      if (loading) loading.style.display = 'none';
      // @ts-ignore — Redoc is exposed on window after standalone bundle loads
      window.Redoc.init('/brewpage-openapi/openapi.json', {
        theme: {
          colors: { primary: { main: '#EBBB40' } },
          typography: { fontSize: '14px' },
        },
        scrollYOffset: 80,
        hideDownloadButton: false,
        expandResponses: '200,201',
        nativeScrollbars: true,
        pathInMiddlePanel: true,
        requiredPropsFirst: true,
      }, container);
    };
    document.head.appendChild(script);
  }
</script>
