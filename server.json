{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "brewpage-mcp",
  "description": "MCP server for BrewPage — publish HTML pages, JSON documents, key-value pairs, files, and multi-file sites to brewpage.app directly from Claude Desktop, Claude Code, or any MCP-compatible client. Stdio transport, zero-config, free hosting with TTL-based retention.",
  "version": "1.3.0",
  "websiteUrl": "https://brewpage.app",
  "homepage": "https://brewpage.app",
  "repository": {
    "url": "https://github.com/kochetkov-ma/brewpage-openapi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "brewpage-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "categories": [
    "hosting",
    "publishing",
    "developer-tools",
    "static-sites",
    "content-management"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "anthropic",
    "hosting",
    "html",
    "json",
    "key-value",
    "file-sharing",
    "static-site"
  ]
}
