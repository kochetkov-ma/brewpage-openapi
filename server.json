{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kochetkov-ma/brewpage-mcp",
  "description": "Publish HTML, Markdown, sites, KV, JSON and files on BrewPage; keep the returned owner token.",
  "version": "1.15.4",
  "websiteUrl": "https://brewpage.app",
  "homepage": "https://brewpage.app",
  "repository": {
    "url": "https://github.com/kochetkov-ma/brewpage-openapi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "brewpage-mcp",
      "version": "1.15.4",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
