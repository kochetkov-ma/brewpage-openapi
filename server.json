      "type": "streamable-http",
      "url": "https://brewpage.app/mcp"
    }
  ],
  "categories": [
    "hosting",
    "publishing",
    "developer-tools",
    "static-sites",
    "content-management"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "claude",
    "anthropic",
    "hosting",
